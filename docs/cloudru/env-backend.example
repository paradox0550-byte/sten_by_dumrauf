NODE_ENV=production
PORT=8080
DB_HOST=<cloudru-postgres-host>
DB_PORT=5432
DB_NAME=<db-name>
DB_USER=<db-user>
DB_PASSWORD=<set-in-secret-store>
JWT_SECRET=<new-random-secret-after-rotation>
JWT_TTL_SECONDS=2592000
UNLOCK_CODE_HASH=<bcrypt-hash>
ADMIN_EMAIL=<admin-email>
ADMIN_ROLE=super_admin
DEFAULT_ORG_ID=<organization-uuid>
YANDEXGPT_API_KEY=<set-in-secret-store>
YC_FOLDER_ID=<folder-id>
YANDEXGPT_MODEL=yandexgpt
OBJECT_STORAGE_BUCKET=smenavkarmane-business
OBJECT_STORAGE_ENDPOINT=https://s3.cloud.ru
OBJECT_STORAGE_REGION=ru-central-1
AWS_ACCESS_KEY_ID=<cloudru-access-key>
AWS_SECRET_ACCESS_KEY=<set-in-secret-store>
ALLOWED_ORIGINS=https://smenavkarmane-business.website.yandexcloud.net
MARKITDOWN_URL=http://sten-markitdown:8080/
MARKITDOWN_ENABLED=false
MARKITDOWN_AUTH_MODE=token
MARKITDOWN_TOKEN=<shared-random-token>
MARKITDOWN_TIMEOUT_MS=60000
TELEGRAM_BOT_TOKEN=<set-in-secret-store>
TELEGRAM_WEBHOOK_SECRET=<set-in-secret-store>
